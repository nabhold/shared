{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nabhold.com/control-plane/v1/event-envelope.schema.json",
  "title": "Nabhold event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "type", "source", "subject", "time", "correlation_id", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^com\\.nabhold\\.[a-z0-9.-]+\\.v[1-9][0-9]*$" },
    "source": { "type": "string", "format": "uri-reference" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 255 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" },
    "tenant_id": { "$ref": "domain.schema.json#/$defs/tenantId" },
    "traceparent": { "type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "data": { "type": "object" }
  }
}

