{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.nabhold.com/contracts/identity-events/v1/membership-revoked.schema.json",
  "title": "MembershipRevokedEvent",
  "description": "Emitted when a membership is revoked.",
  "type": "object",
  "allOf": [
    { "$ref": "../../common/event-envelope.schema.json" }
  ],
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "membership_id": {
          "type": "string",
          "format": "uuid"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "previous_status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED"]
        },
        "new_status": {
          "type": "string",
          "enum": ["REVOKED", "EXPIRED"]
        },
        "reason": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      },
      "required": ["membership_id", "principal_id", "resource_type", "resource_id", "new_status", "reason", "actor"]
    }
  }
}